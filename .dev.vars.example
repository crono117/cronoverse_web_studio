# Server-only Worker settings. Copy to .dev.vars for pnpm dev / pnpm start.
INQUIRY_BACKEND_URL=http://127.0.0.1:8000
# Must match backend/.env; use a long random value in production.
INQUIRY_API_KEY=local-development-only-key

# Public GA4 web-stream Measurement ID (G-...). Empty disables analytics.
GA4_MEASUREMENT_ID=

# Public origin(s) the form may submit from, comma-separated. Leave empty locally. Behind a
# TLS-terminating proxy, set the https origin of the site (for example https://example.com).
INQUIRY_ALLOWED_ORIGINS=

# Cloudflare Turnstile spam protection; enforced only when both are set, so leave empty to disable.
# For local testing Cloudflare publishes keys that always pass:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
