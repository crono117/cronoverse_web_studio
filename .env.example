# Hosted Worker runtime keys. Configure these through the hosting service.
# Local Wrangler development reads .dev.vars (see .dev.vars.example).
INQUIRY_BACKEND_URL=http://127.0.0.1:8000
INQUIRY_API_KEY=local-development-only-key

# Public GA4 web-stream Measurement ID (G-...). Empty disables analytics.
GA4_MEASUREMENT_ID=
