# Copy to .env and fill in real values. Never commit the real .env file.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-secret-value

# "True" only for local development. Always "False" in production.
DJANGO_DEBUG=True

# Comma-separated hostnames this server will answer for.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated browser origins allowed to call this API. Match whatever
# port the frontend dev server prints (corepack pnpm dev), e.g. 5173.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Origins allowed to send cookie-authenticated (CSRF-protected) requests.
# Usually empty for local dev; set this for a production admin/API split
# across subdomains.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Anonymous submission rate limit for POST /api/leads/.
DJANGO_LEAD_THROTTLE_RATE=5/hour

# Optional: set to use PostgreSQL instead of the default local SQLite file.
# Example: postgres://USER:PASSWORD@HOST:5432/NAME
# DATABASE_URL=

# Production only: redirect all HTTP traffic to HTTPS. Leave unset locally.
# DJANGO_SECURE_SSL_REDIRECT=True
