# Development settings. Emails print to the worker terminal until SMTP is selected.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=django-insecure-local-development-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_PUBLIC_BASE_URL=http://127.0.0.1:8000
DJANGO_TRUST_PROXY=0
# Empty uses backend/data/db.sqlite3 locally.
DATABASE_URL=
INQUIRY_API_KEY=local-development-only-key

# Selected Cronoverse addresses. Enable info as a mailbox or alias for replies.
DEFAULT_FROM_EMAIL=Cronoverse Web Studio <info@cronoverse.online>
INQUIRY_NOTIFICATION_EMAIL=lh@cronoverse.online
INQUIRY_REPLY_TO_EMAIL=info@cronoverse.online
STUDIO_URL=https://cronoverse.online

# Mailjet SMTP. Select the SMTP backend and supply both Mailjet keys on the server.
# Local development continues printing emails until the SMTP backend is selected.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=in-v3.mailjet.com
EMAIL_PORT=587
# Mailjet API Key (SMTP username), supplied through server secret storage.
EMAIL_HOST_USER=
# Mailjet Secret Key (SMTP password), supplied through server secret storage.
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=15

# Used only by compose.yaml. Replace the local example before deployment.
POSTGRES_DB=cronoverse
POSTGRES_USER=cronoverse
POSTGRES_PASSWORD=local-demo-change-before-deploy
