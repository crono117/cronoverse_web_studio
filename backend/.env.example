# Development settings. Emails print to the worker terminal until SMTP is selected.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=django-insecure-local-development-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_PUBLIC_BASE_URL=http://127.0.0.1:8000
DJANGO_TRUST_PROXY=0
# Empty uses backend/data/db.sqlite3 locally.
DATABASE_URL=
INQUIRY_API_KEY=local-development-only-key

# Replace these with the approved sender and the owner's notification mailbox.
DEFAULT_FROM_EMAIL=Cronoverse Web Studio <hello@example.com>
INQUIRY_NOTIFICATION_EMAIL=you@example.com
INQUIRY_REPLY_TO_EMAIL=you@example.com
STUDIO_URL=https://cronoverse.online

# Set to django.core.mail.backends.smtp.EmailBackend to send real email.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=15

# Used only by compose.yaml. Replace the local example before deployment.
POSTGRES_DB=cronoverse
POSTGRES_USER=cronoverse
POSTGRES_PASSWORD=local-demo-change-before-deploy
