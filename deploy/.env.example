# Copy to deploy/.env on the machine that runs the stack and fill in the blanks.
# deploy/.env is ignored by Git. Never commit it or paste its values into a PR.
# Generate random values with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Values must not contain spaces, quotes, or '#', and a '$' must be written '$$'.

# Image tag to run (ship.sh sets this for you when it starts the stack).
CRONOVERSE_TAG=latest

# --- Secrets (generate each one; do not reuse) ---
# Shared server-to-server key. The frontend and Django must hold the same value (32+ chars).
INQUIRY_API_KEY=
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# --- Public hostnames ---
# Website: cronoverse.online and www. Admin and API: its own hostname. Create A records for
# all three pointing at the server, and keep them in the three settings below.
DJANGO_ALLOWED_HOSTS=backend,admin.cronoverse.online
DJANGO_CSRF_TRUSTED_ORIGINS=https://admin.cronoverse.online
DJANGO_PUBLIC_BASE_URL=https://admin.cronoverse.online
STUDIO_URL=https://cronoverse.online

# TLS ends at the reverse proxy and Django has no published port, so Django must trust the
# proxy's forwarded protocol and must not redirect the frontend's internal HTTP calls.
DJANGO_TRUST_PROXY=1
DJANGO_SECURE_SSL_REDIRECT=0

# --- Email through Mailjet ---
DEFAULT_FROM_EMAIL=Cronoverse Web Studio <info@cronoverse.online>
INQUIRY_NOTIFICATION_EMAIL=lh@cronoverse.online
INQUIRY_REPLY_TO_EMAIL=info@cronoverse.online
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=in-v3.mailjet.com
# DigitalOcean blocks outbound SMTP on ports 25, 465, and 587. Mailjet also accepts STARTTLS
# on 2525, which is reachable. On a host without that block, 587 works the same way.
EMAIL_PORT=2525
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
# Mailjet API Key and Secret Key (the SMTP username and password).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Google Analytics ---
# Public Web-stream ID (G-...). Empty disables tracking.
GA4_MEASUREMENT_ID=
# Numeric property ID for the admin reports. Needs the credential overlay
# (compose.analytics.yaml) and GA4_CREDENTIALS_SOURCE_FILE below.
GA4_PROPERTY_ID=
GA4_CREDENTIALS_SOURCE_FILE=
